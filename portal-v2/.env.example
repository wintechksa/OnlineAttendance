# Safe to expose in the browser. Use a Supabase publishable key, never service_role.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Cloudflare Pages secrets (set in Cloudflare; never put real values here).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_CLOUDFLARE_ONLY
TIMESTATION_API_KEY=ROTATE_AND_REPLACE_IN_CLOUDFLARE_ONLY
